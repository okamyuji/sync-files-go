# dev 環境のサンプル tfvars
#
# 使い方:
#   cp terraform.tfvars.example terraform.tfvars
#   terraform init
#   terraform apply

aws_region  = "ap-northeast-1"
aws_profile = "sync-admin"

instance_type     = "t4g.small"
db_instance_class = "db.t4g.micro"

# 公開ドメイン名 (例: sync-dev.example.com)
domain_name = "sync-dev.example.com"
base_url    = "https://sync-dev.example.com"

# Let's Encrypt 通知用
letsencrypt_email = "ops@example.com"

alert_emails = [
  "ops@example.com",
]
