# Copy this file to deploy/docker/.env and fill local-only values.
# Do not commit deploy/docker/.env.

SYNC_FILES_MYSQL_PASSWORD=
SYNC_FILES_MYSQL_ROOT_PASSWORD=

# base64-encoded 32-byte keys.
# Generate with: openssl rand -base64 32
SYNC_FILES_AES_MASTER_KEY=
SYNC_FILES_TOTP_HMAC_KEY=
SYNC_FILES_CSRF_KEY=
SYNC_FILES_SESSION_KEY=
