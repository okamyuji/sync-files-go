{{- /* file_row  ファイル一覧の 1 行。 */ -}}
{{- define "partials/file_row" -}}
{{- /* 期待入力: dict "file" <file struct> "csrf" <token> */ -}}
{{- with .file }}
<tr id="file-{{ .id }}" data-file-id="{{ .id }}">
  <td>
    <a class="file-name" href="/files/{{ .id }}">
      <svg class="file-name-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/>
      </svg>
      {{ .name }}
    </a>
  </td>
  <td class="file-meta">{{ formatBytes .size_bytes }}</td>
  <td class="file-meta"><time datetime="{{ .updated_at }}">{{ .updated_at }}</time></td>
  <td class="file-actions">
    <a class="btn btn-ghost btn-sm" href="/api/files/{{ .id }}" download>ダウンロード</a>
    <button class="btn btn-danger btn-sm"
            type="button"
            hx-delete="/api/files/{{ .id }}"
            hx-confirm="このファイルをゴミ箱に移動しますか？"
            hx-target="#file-{{ .id }}"
            hx-swap="outerHTML">
      削除
    </button>
  </td>
</tr>
{{- end -}}
{{- end -}}
