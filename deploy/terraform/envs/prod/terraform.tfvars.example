# prod 環境のサンプル tfvars
aws_region  = "ap-northeast-1"
aws_profile = "sync-admin"

instance_type     = "t4g.small"
data_volume_gb    = 100
db_instance_class = "db.t4g.small"

domain_name       = "sync.example.com"
base_url          = "https://sync.example.com"
letsencrypt_email = "ops@example.com"

alert_emails = [
  "ops@example.com",
  "oncall@example.com",
]
